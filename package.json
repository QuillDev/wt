{
  "name": "wt",
  "version": "0.1.5",
  "private": true,
  "bin": {
    "wt": "./src/index.ts"
  },
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "fix": "bun run format && bun run lint:fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "install-local": "ln -sf \"$PWD/src/index.ts\" \"$HOME/.local/bin/wt\" && chmod +x \"$PWD/src/index.ts\"",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@opentui/core": "^0.3.4",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260608.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
